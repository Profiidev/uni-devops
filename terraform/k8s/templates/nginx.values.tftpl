controller:
  ingressClassResource:
    name: ${ingress_class}
    enabled: true
    default: true
    controllerValue: "k8s.io/ingress-nginx"
    parameters: {}

  ingressClass: ${ingress_class}
  watchIngressWithoutClass: false

  service:
    annotations:
      service.beta.kubernetes.io/azure-load-balancer-ip: ${load_balancer_ip}
    type: LoadBalancer
